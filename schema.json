{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wildwavestylez/travel/blob/main/schema.json",
  "title": "TRAVEL Geographic Knowledge Record",
  "description": "Country-agnostic canonical schema for the TRAVEL geographic knowledge layer. Country-specific geographic and administrative conventions belong in each country's COUNTRY_PROFILE.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "country_code",
    "area",
    "administrative",
    "representative_point",
    "facts",
    "translations",
    "verification"
  ],
  "properties": {
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 country code."
    },
    "area": {
      "$ref": "#/$defs/area"
    },
    "administrative": {
      "$ref": "#/$defs/administrative"
    },
    "representative_place": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human-readable representative place or feature characterising the area. It is not a navigation or game stop."
    },
    "representative_point": {
      "$ref": "#/$defs/point"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "photo": {
      "anyOf": [
        {
          "$ref": "#/$defs/photo"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "translations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/translation"
      }
    },
    "verification": {
      "$ref": "#/$defs/verification"
    }
  },
  "$defs": {
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "identifier_type",
        "name",
        "type"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "identifier_type": {
          "type": "string",
          "enum": [
            "postal_code",
            "postal_area",
            "municipality",
            "locality",
            "settlement",
            "administrative_area",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "administrative": {
      "type": "object",
      "description": "Country-neutral administrative hierarchy. Meaning of each level is defined by the country profile.",
      "additionalProperties": false,
      "properties": {
        "level_1": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_2": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_3": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_4": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text",
        "category",
        "priority",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fact_[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "nature_and_landscape",
            "heritage_and_monuments",
            "history",
            "culture_and_industry",
            "people",
            "geography_and_context",
            "tourism_and_surroundings",
            "hidden_gem",
            "local_story",
            "other_verified_significance"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ],
          "description": "Coordinates of the concrete place to which this fact refers. Null when the fact concerns the wider area rather than one precise location."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^source_[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string",
          "enum": [
            "official",
            "primary",
            "archive",
            "museum",
            "university",
            "specialist",
            "news",
            "regional",
            "other"
          ]
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representative_place",
        "facts"
      ],
      "properties": {
        "representative_place": {
          "type": [
            "string",
            "null"
          ]
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/translated_fact"
          }
        }
      }
    },
    "translated_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fact_[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geographic_test_data"
      ],
      "properties": {
        "geographic_test_data": {
          "type": "boolean"
        },
        "identifier_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
