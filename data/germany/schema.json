{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRAVEL German postcode stop — Content Standard V3.1",
  "description": "Content Standard V3.1 schema, including explicit fact-level map categories for consistent tourist map iconography and a dedicated personality pin.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "postcode",
    "city",
    "district",
    "county",
    "state",
    "representative_place",
    "representative_point",
    "access_point",
    "facts",
    "photo",
    "verification",
    "sources",
    "translations"
  ],
  "properties": {
    "postcode": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "district": {
      "type": [
        "string",
        "null"
      ]
    },
    "county": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": [
        "string",
        "null"
      ]
    },
    "representative_place": {
      "type": "string",
      "minLength": 1
    },
    "representative_point": {
      "$ref": "#/$defs/point",
      "description": "Coordinates of the postcode's single representative_place. This is a postcode-level representative location, not an access point and not a fact location."
    },
    "access_point": {
      "$ref": "#/$defs/point",
      "description": "Coordinates of the practical access/arrival point for the postcode. This is not the representative place and not a fact location."
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "photo": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[\\x00-\\x7F]+$",
          "format": "uri",
          "description": "When present, must be a valid URI containing ASCII characters only. UTF-8 characters such as ä, ö, ü and ß must be percent-encoded."
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plz_source",
        "geographic_test_data",
        "access_point_verified"
      ],
      "properties": {
        "plz_source": {
          "type": "string",
          "minLength": 1
        },
        "geographic_test_data": {
          "type": "boolean"
        },
        "access_point_verified": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "translations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cs",
        "de",
        "en",
        "es",
        "fr",
        "it"
      ],
      "properties": {
        "cs": {
          "$ref": "#/$defs/translation"
        },
        "de": {
          "$ref": "#/$defs/translation"
        },
        "en": {
          "$ref": "#/$defs/translation"
        },
        "es": {
          "$ref": "#/$defs/translation"
        },
        "fr": {
          "$ref": "#/$defs/translation"
        },
        "it": {
          "$ref": "#/$defs/translation"
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text",
        "category",
        "priority",
        "sources",
        "map_category"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fact_[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "nature_and_landscape",
            "heritage_and_monuments",
            "architecture_and_urbanism",
            "history",
            "culture_and_industry",
            "people",
            "geography_and_context",
            "tourism_and_surroundings",
            "hidden_gem",
            "local_story",
            "other_verified_significance"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "location": {
          "description": "Independent geographic location of the subject of this specific fact. Do not copy representative_point or access_point here. Optional only for legacy-record compatibility; new/enriched facts must include this property and use null when a defensible location cannot be verified.",
          "oneOf": [
            {
              "$ref": "#/$defs/fact_location"
            },
            {
              "type": "null"
            }
          ]
        },
        "map_category": {
          "type": "string",
          "enum": [
            "castle",
            "historical_monument",
            "nature",
            "viewpoint_landscape",
            "historic_city",
            "museum",
            "religious_site",
            "technical_heritage",
            "personality"
          ],
          "description": "Single primary map category for the specific subject of this fact. Use personality for facts whose primary subject is a specific person, regardless of the physical site used for the map location. Used only for map iconography; the existing category field retains its broader editorial meaning."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "type"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^[\\x00-\\x7F]+$",
          "format": "uri",
          "description": "Must be a valid URI containing ASCII characters only. UTF-8 characters such as ä, ö, ü and ß must be percent-encoded."
        },
        "type": {
          "type": "string",
          "enum": [
            "official",
            "primary",
            "archive",
            "museum",
            "university",
            "specialist",
            "news",
            "regional",
            "other"
          ]
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representative_place",
        "facts"
      ],
      "properties": {
        "representative_place": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/translated_fact"
          }
        }
      }
    },
    "translated_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fact_[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fact_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "lat",
        "lon",
        "type",
        "accuracy",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the specific site, feature, or historically documented place to which the fact refers."
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "description": "Verified postal address when one exists; null for natural features or locations without a reliable street address."
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "type": {
          "type": "string",
          "enum": [
            "agricultural_landscape",
            "airport",
            "airport_area",
            "airport_building",
            "arboretum",
            "archaeological_site",
            "architectural_ensemble",
            "archive",
            "artworks",
            "brewery",
            "brewery_site",
            "bridge",
            "building",
            "bunker",
            "business_park",
            "canal",
            "canal_settlement",
            "castle",
            "cemetery",
            "church",
            "church_historic_site",
            "cinema",
            "community_center",
            "community_garden",
            "crematorium",
            "cultural_center",
            "event_location",
            "factory",
            "farm",
            "ferry_crossing",
            "ferry_landing",
            "film_studio_site",
            "fire_station",
            "forest",
            "former_military_training_area",
            "fountain",
            "gallery",
            "garden",
            "harbor",
            "highrise",
            "hill",
            "hills",
            "hills_viewpoint",
            "hindu_temple",
            "historic_address",
            "historic_airfield",
            "historic_bathing_site",
            "historic_building",
            "historic_buildings",
            "historic_city",
            "historic_crematorium",
            "historic_district",
            "historic_ensemble",
            "historic_estate",
            "historic_farmstead",
            "historic_fire_station",
            "historic_hospital",
            "historic_industrial_district",
            "historic_industrial_site",
            "historic_inn",
            "historic_island",
            "historic_landscape",
            "historic_manor",
            "historic_military_site",
            "historic_monument",
            "historic_nursery",
            "historic_railway_site",
            "historic_restaurant",
            "historic_settlement",
            "historic_site",
            "historic_square",
            "historic_street",
            "historic_studio",
            "historic_tramway",
            "historic_transport_site",
            "historic_villa",
            "historic_village",
            "historic_village_center",
            "historic_villages",
            "historic_villas",
            "historic_waterway",
            "historic_workshop",
            "historical_monument",
            "historical_site",
            "hospital",
            "hotel_congress_center",
            "industrial_area",
            "industrial_monument",
            "industrial_site",
            "infrastructure",
            "island",
            "landmark",
            "landscape",
            "landscape_area",
            "landscape_park",
            "lido",
            "literary_site",
            "market",
            "media_campus",
            "memorial",
            "memorial_museum",
            "memorial_site",
            "memorial_tree",
            "metro_line_site",
            "metro_station",
            "model_railway",
            "monument",
            "museum",
            "natural_feature",
            "natural_monument",
            "nature",
            "nature_area",
            "nature_reserve",
            "nature_site",
            "neighborhood",
            "observatory",
            "other",
            "park",
            "pavilion",
            "pedestrian_bridge",
            "pedestrian_street",
            "pedestrian_tunnel",
            "peninsula",
            "pond",
            "ponds",
            "postal_area",
            "power_station",
            "racecourse",
            "railway_hall",
            "railway_heritage",
            "railway_station",
            "religious_site",
            "research_campus",
            "research_facility",
            "research_site",
            "residential_area",
            "residential_building",
            "residential_ensemble",
            "riverside",
            "rowing_club_site",
            "rowing_course",
            "school",
            "school_site",
            "sculptures",
            "shopping_center",
            "square",
            "square_pond",
            "stadium",
            "street",
            "sundial",
            "survey_marker",
            "swimming_pool",
            "technical_heritage",
            "technical_monument",
            "technology_park",
            "town_hall",
            "transport",
            "university_campus",
            "university_hospital",
            "urban_center",
            "urban_design_site",
            "urban_development_site",
            "viewpoint",
            "water_tower",
            "waterway",
            "waterworks",
            "windmill",
            "woodland"
          ],
          "description": "Controlled location type vocabulary synchronized with the published TRAVEL Germany dataset and EuropeExplorer. Use only one of these enumerated values; do not invent free-text types. Add a newly verified type to this schema and the EuropeExplorer schema before publishing records that use it."
        },
        "accuracy": {
          "type": "string",
          "enum": [
            "exact",
            "approximate",
            "area_representative",
            "historical_approximate"
          ],
          "description": "exact = verified point on the specific object/site; approximate = location known but point is not exact; area_representative = representative point used for an extended area or a fact associated with the postal-code area rather than one specific site; historical_approximate = documented historical location whose exact position is uncertain."
        },
        "source": {
          "type": "string",
          "pattern": "^[\\x00-\\x7F]+$",
          "format": "uri",
          "description": "Direct URL supporting the identification or geographic position of this fact location. Must contain ASCII characters only; UTF-8 characters such as ä, ö, ü and ß must be percent-encoded."
        }
      }
    }
  },
  "$comment": "CONTENT STANDARD V3.1: every fact has one required map_category for consistent map iconography. The personality map_category identifies person-centred facts independently of their physical pin location. Existing category remains the broader editorial classification. representative_point, access_point and facts[].location are separate and not interchangeable. A postal_area fact location may intentionally reuse representative_point with type=postal_area and accuracy=area_representative."
}
