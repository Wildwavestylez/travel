{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRAVEL German postcode stop",
  "description": "Canonical TRAVEL German postcode record. This schema and CONTENT_STANDARD.md together are the only production standard for new postcode JSON records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "postcode",
    "city",
    "district",
    "county",
    "state",
    "representative_place",
    "representative_point",
    "access_point",
    "facts",
    "photo",
    "verification",
    "sources",
    "translations"
  ],
  "properties": {
    "postcode": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "district": {
      "type": ["string", "null"]
    },
    "county": {
      "type": ["string", "null"]
    },
    "state": {
      "type": ["string", "null"]
    },
    "representative_place": {
      "type": "string",
      "minLength": 1
    },
    "representative_point": {
      "$ref": "#/$defs/point"
    },
    "access_point": {
      "$ref": "#/$defs/point"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "photo": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "author": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plz_source",
        "geographic_test_data",
        "access_point_verified"
      ],
      "properties": {
        "plz_source": {
          "type": "string",
          "minLength": 1
        },
        "geographic_test_data": {
          "type": "boolean"
        },
        "access_point_verified": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "translations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cs", "de", "en", "es", "fr", "it"],
      "properties": {
        "cs": {"$ref": "#/$defs/translation"},
        "de": {"$ref": "#/$defs/translation"},
        "en": {"$ref": "#/$defs/translation"},
        "es": {"$ref": "#/$defs/translation"},
        "fr": {"$ref": "#/$defs/translation"},
        "it": {"$ref": "#/$defs/translation"}
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text",
        "category",
        "priority",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fact_[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "nature_and_landscape",
            "heritage_and_monuments",
            "history",
            "culture_and_industry",
            "people",
            "geography_and_context",
            "tourism_and_surroundings",
            "hidden_gem",
            "local_story",
            "other_verified_significance"
          ]
        },
        "priority": {
          "type": "string",
          "enum": ["A", "B", "C", "D"]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "type"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string",
          "enum": [
            "official",
            "primary",
            "archive",
            "museum",
            "university",
            "specialist",
            "news",
            "regional",
            "other"
          ]
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representative_place", "facts"],
      "properties": {
        "representative_place": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/translated_fact"
          }
        }
      }
    },
    "translated_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fact_[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}