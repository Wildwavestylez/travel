{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRAVEL Czechia postcode stop",
  "description": "Canonical TRAVEL Czech postcode record. This schema and CONTENT_STANDARD.md together are the production standard for Czechia postcode JSON records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "postcode",
    "city",
    "district",
    "county",
    "state",
    "representative_place",
    "representative_point",
    "access_point",
    "facts",
    "photo",
    "verification",
    "sources",
    "translations"
  ],
  "properties": {
    "postcode": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "description": "Název obce (města i menší obce) podle oficiálního územního členění ČSÚ."
    },
    "district": {
      "type": [
        "string",
        "null"
      ],
      "description": "Konkrétní část obce, městská část, městský obvod, čtvrť nebo pojmenovaná sídelní lokalita uvnitř obce. Pokud není přesnější lokalita určena, použij null."
    },
    "county": {
      "type": [
        "string",
        "null"
      ],
      "description": "Okres podle oficiálního územního členění ČSÚ."
    },
    "state": {
      "type": [
        "string",
        "null"
      ],
      "description": "Kraj podle oficiálního územního členění ČSÚ."
    },
    "representative_place": {
      "type": "string",
      "minLength": 1,
      "description": "Jedno jednoduché orientační reprezentativní místo pro celé PSČ; nemusí být turistickou atrakcí ani geometrickým středem."
    },
    "representative_point": {
      "$ref": "#/$defs/point",
      "description": "Souřadnice orientačního reprezentativního místa PSČ; nejde o polohu konkrétního faktu ani o přístupový bod."
    },
    "access_point": {
      "oneOf": [
        {
          "$ref": "#/$defs/point"
        },
        {
          "type": "null"
        }
      ],
      "description": "Jednoduchý pomocný bod pro příjezd/příchod. Pokud nemá jasný praktický smysl nebo není spolehlivě ověřen, použij null."
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "photo": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plz_source",
        "geographic_test_data",
        "access_point_verified"
      ],
      "properties": {
        "plz_source": {
          "type": "string",
          "minLength": 1,
          "description": "Konkrétní zdroj použitý k ověření PSČ. ČSÚ je jediná primární autorita projektu pro výběr PSČ a jeho přiřazení k území; používej číselník ČSÚ PSČ (kódový seznam 0028) a podle potřeby oficiální adresní data ČSÚ, zejména RSO. Česká pošta může být pouze doplňkovým kontrolním zdrojem a její údaje nesmějí automaticky přebít ČSÚ."
        },
        "geographic_test_data": {
          "type": "boolean"
        },
        "access_point_verified": {
          "type": "boolean"
        },
        "postcode_authority": {
          "type": "string",
          "description": "Primární autorita projektu pro výběr PSČ a jeho přiřazení k území je ČSÚ (identifikátor CSU). Česká pošta může být uvedena pouze jako doplňkový kontrolní zdroj. Textové pole zachovává kompatibilitu se staršími záznamy."
        },
        "postcode_source_dataset": {
          "type": [
            "string",
            "null"
          ]
        },
        "postcode_source_release": {
          "type": [
            "string",
            "null"
          ]
        },
        "postcode_source_checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "postcode_conflict": {
          "type": "boolean"
        },
        "postcode_conflict_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "delivery_office_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "postcode_override_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "geographic_authority": {
          "type": "string",
          "description": "Autorita použitá pro administrativní a statistické územní údaje; u nového ověřování používej ČSÚ (identifikátor CSU). Textové pole zachovává kompatibilitu se staršími záznamy."
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "translations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cs",
        "de",
        "en",
        "es",
        "fr",
        "it"
      ],
      "properties": {
        "cs": {
          "$ref": "#/$defs/translation"
        },
        "de": {
          "$ref": "#/$defs/translation"
        },
        "en": {
          "$ref": "#/$defs/translation"
        },
        "es": {
          "$ref": "#/$defs/translation"
        },
        "fr": {
          "$ref": "#/$defs/translation"
        },
        "it": {
          "$ref": "#/$defs/translation"
        }
      }
    },
    "district_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "municipal_part",
        "municipal_district",
        "city_quarter",
        "settlement",
        "locality",
        null
      ],
      "description": "Nepovinné upřesnění druhu district: municipal_part = oficiální část obce; municipal_district = městská část/obvod; city_quarter = městská čtvrť či lokalita; settlement = sídlo/osada; locality = jiná místní lokalita."
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text",
        "category",
        "priority",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fact_[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "nature_and_landscape",
            "heritage_and_monuments",
            "architecture_and_urbanism",
            "history",
            "culture_and_industry",
            "people",
            "geography_and_context",
            "tourism_and_surroundings",
            "hidden_gem",
            "local_story",
            "other_verified_significance"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "location": {
          "description": "Samostatná geografická poloha objektu nebo místa, kterého se konkrétní fakt týká. Nekopíruj sem representative_point ani access_point. Pole je volitelné kvůli zpětné kompatibilitě; u nových a přepracovaných faktů se vyplňuje, pokud lze polohu doložit, jinak null.",
          "oneOf": [
            {
              "$ref": "#/$defs/fact_location"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "type"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string",
          "enum": [
            "official",
            "primary",
            "archive",
            "museum",
            "university",
            "specialist",
            "news",
            "regional",
            "other"
          ]
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representative_place",
        "facts"
      ],
      "properties": {
        "representative_place": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/translated_fact"
          }
        }
      }
    },
    "translated_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fact_[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fact_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "lat",
        "lon",
        "type",
        "accuracy",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Název konkrétního objektu, místa nebo historicky doložené lokality."
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ověřená poštovní adresa, pokud existuje; jinak null."
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "type": {
          "type": "string",
          "enum": [
            "agricultural_landscape",
            "airport",
            "arboretum",
            "archaeological_site",
            "architectural_ensemble",
            "archive",
            "artwork",
            "brewery",
            "bridge",
            "building",
            "bunker",
            "business_park",
            "canal",
            "castle",
            "cemetery",
            "chapel",
            "church",
            "cinema",
            "city_gate",
            "community_center",
            "cultural_center",
            "dam",
            "factory",
            "farm",
            "ferry_terminal",
            "fire_station",
            "forest",
            "fortress",
            "fountain",
            "gallery",
            "garden",
            "harbor",
            "hill",
            "historic_address",
            "historic_district",
            "historic_estate",
            "historic_industrial_site",
            "historic_monument",
            "historic_railway_site",
            "historic_settlement",
            "historic_square",
            "historic_street",
            "historic_villa",
            "historic_village",
            "historic_waterway",
            "hospital",
            "hotel",
            "industrial_site",
            "infrastructure",
            "island",
            "landmark",
            "landscape",
            "market",
            "memorial",
            "memorial_site",
            "metro_station",
            "mine",
            "monastery",
            "monument",
            "mosque",
            "museum",
            "natural_feature",
            "natural_monument",
            "nature_reserve",
            "neighborhood",
            "observatory",
            "open_air_museum",
            "park",
            "pedestrian_street",
            "pilgrimage_site",
            "pond",
            "power_station",
            "quarry",
            "railway_station",
            "religious_site",
            "research_facility",
            "residential_ensemble",
            "river",
            "rock_formation",
            "school",
            "sculpture",
            "shopping_center",
            "square",
            "stadium",
            "street",
            "synagogue",
            "technical_monument",
            "technology_park",
            "theatre",
            "town_hall",
            "transport_hub",
            "university",
            "viewpoint",
            "waterfall",
            "water_tower",
            "waterway",
            "waterworks",
            "windmill",
            "woodland",
            "zoo",
            "spa",
            "cave",
            "battlefield",
            "protected_area",
            "national_park",
            "geological_site",
            "lookout_tower",
            "fortification",
            "ruin",
            "library",
            "sports_facility",
            "swimming_pool",
            "camping_site",
            "railway_heritage_site",
            "industrial_heritage_site",
            "historic_bridge",
            "historic_church",
            "historic_park",
            "historic_garden",
            "historic_cemetery",
            "historic_mill",
            "historic_mine",
            "historic_quarry",
            "historic_brewery",
            "historic_factory",
            "historic_workshop",
            "historic_market",
            "historic_station",
            "historic_fortress",
            "postal_area"
          ],
          "description": "Řízený český slovník typů polohy faktu v jednotném čísle. postal_area označuje faktum vztahující se k oblasti PSČ bez jediného konkrétního fyzického místa."
        },
        "accuracy": {
          "type": "string",
          "enum": [
            "exact",
            "approximate",
            "area_representative",
            "historical_approximate"
          ],
          "description": "exact = ověřený bod objektu; approximate = známá lokalita s nepřesným bodem; area_representative = reprezentativní bod rozlehlého území; historical_approximate = doložená historická poloha s nejistým přesným umístěním."
        },
        "source": {
          "type": "string",
          "format": "uri",
          "description": "Přímá URL dokládající identifikaci místa nebo jeho geografickou polohu."
        }
      },
      "description": "Geografická poloha konkrétního faktu podle stejných principů jako německé TRAVEL. U nových a přepracovaných faktů uveď location; použij null pouze tehdy, když nelze obhajitelnou polohu doložit. Nikdy automaticky nekopíruj representative_point ani access_point."
    }
  },
  "$comment": "CZECHIA CONTENT STANDARD: Czechia uses Czech administrative terminology and an independent location-type dictionary. Fact-location behavior follows German TRAVEL rules. Shared editorial fact categories stay aligned with Germany for EuropeExplorer compatibility. Do not modify German schema or records."
}
